#####################################
#  Kometa & Last Chance Environment  #
#####################################
# Copy this file to .env and fill in your values.
# Used by both Kometa (config.yml <<PLACEHOLDER>> resolution) and the
# Last Chance cleanup script. All variables use the KOMETA_ prefix.

# ---- Plex ----
KOMETA_PLEXURL=
KOMETA_PLEXTOKEN=

# ---- Radarr ----
KOMETA_RADARRURL=
KOMETA_RADARRTOKEN=
KOMETA_RADARRROOTFOLDERPATH=
KOMETA_RADARRQUALITYPROFILE=

# ---- Sonarr ----
KOMETA_SONARRURL=
KOMETA_SONARRTOKEN=
KOMETA_SONARRROOTFOLDERPATH=
KOMETA_SONARRQUALITYPROFILE=

# ---- Gotify (notifications) ----
KOMETA_GOTIFYURL=
KOMETA_GOTIFYTOKEN=

# ---- TMDB ----
KOMETA_TMDBAPIKEY=

# ---- OMDB ----
KOMETA_OMDBAPIKEY=

# ---- MDBList ----
KOMETA_MDBLISTAPIKEY=

# ---- Tautulli ----
KOMETA_TAUTULLIURL=
KOMETA_TAUTULLIAPIKEY=

# ---- Trakt ----
KOMETA_TRAKTCLIENTID=
KOMETA_TRAKTCLIENTSECRET=
KOMETA_TRAKTPIN=

# ---- Overlay Settings ----
KOMETA_REMOVEOVERLAYSMOVIES=false
KOMETA_REAPPLYOVERLAYSMOVIES=false
KOMETA_REMOVEOVERLAYSSHOWS=false
KOMETA_REAPPLYOVERLAYSSHOWS=false
KOMETA_REMOVEOVERLAYSRETROSHOWS=false
KOMETA_REAPPLYOVERLAYSRETROSHOWS=false
KOMETA_REMOVEOVERLAYSRETROKIDSSHOWS=false
KOMETA_REAPPLYOVERLAYSRETROKIDSSHOWS=false

# ---- Kometa Runtime Flags (optional) ----
# KOMETA_RUN=true
KOMETA_TIMES=06:00
# KOMETA_TIMEOUT=600
# KOMETA_NO_COUNTDOWN=true
# KOMETA_NO_VERIFY_SSL=true
# KOMETA_DEBUG=false
# KOMETA_TRACE=false
# KOMETA_LOG_REQUESTS=false
# KOMETA_NO_REPORT=false
# KOMETA_COLLECTIONS_ONLY=false
# KOMETA_METADATA_ONLY=false
# KOMETA_OPERATIONS_ONLY=false
# KOMETA_OVERLAYS_ONLY=false
